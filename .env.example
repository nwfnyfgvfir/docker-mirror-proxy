MIRROR_DOMAIN=mirror.example.com
MIRROR_TLS_DIR=/srv/docker-mirror/tls
DOCKERHUB_CACHE_DIR=/srv/docker-mirror/dockerhub
GHCR_CACHE_DIR=/srv/docker-mirror/ghcr

# Optional. Use a versioned GHCR gateway image instead of building locally.
# MIRROR_GATEWAY_IMAGE=ghcr.io/nwfnyfgvfir/docker-mirror-proxy:v0.1.0
# MIRROR_GATEWAY_PULL_POLICY=missing

# Optional. A repository-external copy of registry/dockerhub.yml with upstream credentials.
# DOCKERHUB_CONFIG_FILE=/srv/docker-mirror/dockerhub.credentials.yml

MIRROR_IP_RATE=10r/s
MIRROR_IP_BURST=20
MIRROR_IP_CONNECTIONS=8
MIRROR_GLOBAL_RATE=100r/s
MIRROR_GLOBAL_BURST=100
MIRROR_GLOBAL_CONNECTIONS=32
MIRROR_DOWNLOAD_RATE=2m
