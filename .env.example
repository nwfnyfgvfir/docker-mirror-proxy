DOCKERHUB_CACHE_DIR=/srv/docker-mirror/dockerhub
GHCR_CACHE_DIR=/srv/docker-mirror/ghcr

# Docker Hub 回源账号。要登录时两项一起填，留空则匿名回源。
DOCKERHUB_USERNAME=
DOCKERHUB_PAT=

# 可选。无缓存模式下，群晖「镜像仓库」显示的公开镜像，多个用逗号分开。
# REGISTRY_CATALOG=library/alpine,ghcr.io/astral-sh/uv

# Optional. Use a versioned cache image published by the project.
# MIRROR_CACHE_IMAGE=ghcr.io/nwfnyfgvfir/docker-mirror-proxy:<tag>
