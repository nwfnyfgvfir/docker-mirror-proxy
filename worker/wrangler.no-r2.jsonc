{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docker-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "24801", "simple": { "limit": 100, "period": 10 } },
    { "name": "TOTAL_LIMIT", "namespace_id": "24802", "simple": { "limit": 1000, "period": 10 } }
  ]
}
